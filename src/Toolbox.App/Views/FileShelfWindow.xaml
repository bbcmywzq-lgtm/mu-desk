<Window x:Class="PersonalToolbox.Views.FileShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drop · 文件暂存 · MU Desk" Width="22" Height="76"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" AllowDrop="True"
        FontFamily="Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
        SourceInitialized="Window_OnSourceInitialized" PreviewKeyDown="Window_OnPreviewKeyDown"
        MouseEnter="Window_OnMouseEnter" MouseLeave="Window_OnMouseLeave"
        DragEnter="Window_OnDragEnter" DragOver="Window_OnDragOver"
        DragLeave="Window_OnDragLeave" Drop="Window_OnDrop">
    <Window.Resources>
        <Style x:Key="ShelfButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E2ED"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#22FFFFFF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#487A4FD3"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B89ADD"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".38"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ShelfButton}"/>
    </Window.Resources>
    <Grid x:Name="Root">
        <Grid.Clip><RectangleGeometry x:Name="RevealClip" Rect="0,0,22,76" RadiusX="10" RadiusY="10"/></Grid.Clip>
        <Border Background="#F527252E"/>
        <Canvas>
            <Button x:Name="CollapsedButton" Width="22" Height="76" Padding="0"
                    Click="CollapsedButton_OnClick" ToolTip="Drop · 点击展开，也可直接拖入文件"
                    AutomationProperties.Name="展开 Drop 文件暂存">
                <StackPanel VerticalAlignment="Center">
                    <Border Width="3" Height="22" CornerRadius="1.5" Background="#B9ADCF" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CollapsedCountText" Margin="0,8,0,0" Text="0" FontSize="9"
                               Foreground="#D7CFE3" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Border x:Name="ExpandedPanel" Width="360" Height="520" Padding="20,20,18,16" Visibility="Hidden">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Drop" FontSize="22" FontWeight="SemiBold" Foreground="#F4F1F8"/>
                                <TextBlock Text="文件暂存" Margin="10,7,0,0" FontSize="11" Foreground="#AAA2B6"/>
                            </StackPanel>
                            <TextBlock x:Name="SummaryText" Margin="0,5,0,0" FontSize="11" Foreground="#AAA2B6"/>
                        </StackPanel>
                        <Button Grid.Column="1" Width="30" Height="30" Padding="0" VerticalAlignment="Top"
                                Click="CollapseButton_OnClick" ToolTip="收起到屏幕边缘 · Esc" AutomationProperties.Name="收起 Drop">
                            <Path x:Name="CollapseArrow" Data="M 0,0 L 5,5 0,10" Stroke="#D4CDDF" StrokeThickness="1.6"/>
                        </Button>
                    </Grid>
                    <Border x:Name="DropHint" Grid.Row="1" Margin="0,18,0,14" Padding="12,11"
                            Background="#14FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="10">
                        <TextBlock x:Name="DropHintText" Foreground="#C7BFD3" Text="拖入暂存，拖出继续使用" FontSize="12"/>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <StackPanel x:Name="BatchesPanel"/>
                    </ScrollViewer>
                    <Border x:Name="StatusPanel" Grid.Row="3" Margin="0,10,0,0" Padding="10,8"
                            CornerRadius="8" BorderThickness="1" Visibility="Collapsed">
                        <TextBlock x:Name="StatusText" Foreground="#ECE6F4" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="UndoButton" Content="撤销移除" Click="UndoButton_OnClick" Visibility="Hidden"
                                HorizontalAlignment="Left" Background="#357A4FD3"/>
                        <Button x:Name="ClearButton" Grid.Column="1" Content="清空未固定项" Click="ClearButton_OnClick" Foreground="#B5ADBF"/>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Foreground="#9990A6"
                                   FontSize="10" Text="只暂存路径，原文件留在原处。"/>
                    </Grid>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</Window>
