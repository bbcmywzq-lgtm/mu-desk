<Window x:Class="PersonalToolbox.Views.CueToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mujun Cue · MU Desk" Width="72" Height="12"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        PreviewKeyDown="Window_OnKeyDown" MouseEnter="Window_OnMouseEnter" MouseLeave="Window_OnMouseLeave">
    <Window.Resources>
        <Style x:Key="ToolBase" TargetType="{x:Type ButtonBase}">
            <Setter Property="Width" Value="48"/><Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="#DCD9E5"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="500"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ButtonBase}">
                        <Border x:Name="Chrome" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Width="19" Height="19" Stretch="Uniform" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter Margin="0,5,0,0" HorizontalAlignment="Center"
                                                  TextElement.FontSize="10" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#397A4FD3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tool" TargetType="Button" BasedOn="{StaticResource ToolBase}"/>
        <Style x:Key="ToggleTool" TargetType="ToggleButton" BasedOn="{StaticResource ToolBase}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#487A4FD3"/>
                    <Setter Property="BorderBrush" Value="#997A4FD3"/>
                    <Setter Property="Foreground" Value="#EEE5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1"/><Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="9,0"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#25FFFFFF"/>
        </Style>
        <Style x:Key="AnnotationTool" TargetType="Button" BasedOn="{StaticResource Tool}">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="46"/>
        </Style>
        <Style x:Key="AnnotationToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleTool}">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="46"/>
        </Style>
        <Style x:Key="CueMenu" TargetType="ContextMenu">
            <Setter Property="Foreground" Value="#E7E1EF"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border Background="#FC292630" BorderBrush="#514B5D" BorderThickness="1" CornerRadius="12" Padding="6">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CueMenuItem" TargetType="MenuItem">
            <Setter Property="MinWidth" Value="152"/><Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#E7E1EF"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="MenuChrome" Background="Transparent" CornerRadius="7" Padding="12,6">
                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuChrome" Property="Background" Value="#447A4FD3"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" ClipToBounds="True">
        <Grid.Clip><RectangleGeometry x:Name="RevealClip" Rect="0,-8,72,20" RadiusX="8" RadiusY="8"/></Grid.Clip>
        <Border x:Name="Shell" Background="#F027252E"/>
        <Button x:Name="Notch" Click="Expand_OnClick" ToolTip="Mujun Cue · 点击展开工具栏"
                AutomationProperties.Name="展开 Mujun Cue 工具栏" Style="{x:Null}" Cursor="Hand" Focusable="True" Padding="0"
                Width="72" Height="12" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NotchSurface" CornerRadius="0,0,8,8" Background="Transparent">
                        <Border Width="20" Height="2" CornerRadius="1" Background="#958F9E" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NotchSurface" Property="Background" Value="#FF37303F"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NotchSurface" Property="Background" Value="#FF37303F"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Border x:Name="ExpandedSurface" Padding="12,9" Visibility="Hidden" Background="Transparent"
                Width="748" Height="72" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
              <Grid>
                <StackPanel x:Name="MainTools" Orientation="Horizontal">
                    <StackPanel Width="65" VerticalAlignment="Center" Margin="2,0,0,0" MouseLeftButtonDown="Drag_OnMouseDown" Cursor="SizeAll" Background="Transparent" ToolTip="拖动工具栏到上方或下方">
                        <TextBlock Text="Cue" FontFamily="Segoe UI Variable" FontSize="20" FontWeight="SemiBold" Foreground="#FAF7FF"/>
                        <TextBlock Text="MUJUN" Margin="1,2,0,0" FontSize="8" Foreground="#A69EAF"/>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}"/>
                    <ToggleButton x:Name="RingButton" Style="{StaticResource ToggleTool}" Content="圆环" ToolTip="鼠标圆环" Click="Ring_OnClick" Tag="M12,3 A9,9 0 1 1 11.99,3 M12,9 A3,3 0 1 1 11.99,9"/>
                    <ToggleButton x:Name="LaserButton" Style="{StaticResource ToggleTool}" Content="激光" ToolTip="激光指示" Click="Laser_OnClick" Tag="M3,21 L15,9 M12,9 L15,12 M17,7 L20,4 M19,10 L23,10 M14,5 L14,1"/>
                    <ToggleButton x:Name="ClickButton" Style="{StaticResource ToggleTool}" Content="点击" ToolTip="点击反馈" Click="Click_OnClick" Tag="M7,5 L7,19 L11,15 L15,21 L18,19 L14,13 L20,12 Z M3,6 L1,4 M7,2 L7,0 M11,4 L13,2"/>
                    <ToggleButton x:Name="SpotlightButton" Style="{StaticResource ToggleTool}" Content="聚光" ToolTip="聚光灯" Click="Spotlight_OnClick" Tag="M9,2 L15,2 L18,8 L6,8 Z M6,12 L3,21 M12,12 L12,22 M18,12 L21,21"/>
                    <ToggleButton x:Name="MagnifierButton" Style="{StaticResource ToggleTool}" Content="放大" ToolTip="无边框放大镜" Click="Magnifier_OnClick" Tag="M10,2 A8,8 0 1 1 9.99,2 M16,16 L23,23 M6,10 L14,10 M10,6 L10,14"/>
                    <Border Style="{StaticResource Divider}"/>
                    <Button Style="{StaticResource Tool}" Content="标注" Click="Annotation_OnClick" ToolTip="屏幕标注" Tag="M4,15 L15,4 L20,9 L9,20 L3,21 Z M13,6 L18,11 M4,15 L9,20"/>
                    <Button Style="{StaticResource Tool}" Content="截屏" Click="Screenshot_OnClick" ToolTip="截取当前屏幕" Tag="M3,6 L8,6 L10,3 L15,3 L17,6 L22,6 L22,21 L2,21 L2,6 Z M12,9 A4,4 0 1 1 11.99,9"/>
                    <Button Style="{StaticResource Tool}" Content="框选" Click="RegionScreenshot_OnClick" ToolTip="框选截图" Tag="M2,8 L2,2 L8,2 M16,2 L22,2 L22,8 M22,16 L22,22 L16,22 M8,22 L2,22 L2,16"/>
                    <Border Style="{StaticResource Divider}"/>
                    <Button Style="{StaticResource Tool}" Content="复原" Click="Reset_OnClick" ToolTip="复原所有屏幕效果" Tag="M4,8 A9,9 0 1 1 3,16 M4,2 L4,8 L10,8"/>
                    <Button Style="{StaticResource Tool}" Content="设置" Click="Settings_OnClick" ToolTip="Cue 设置" Tag="M3,5 L21,5 M3,12 L21,12 M3,19 L21,19 M8,2 L8,8 M16,9 L16,15 M10,16 L10,22"/>
                    <Button x:Name="CollapseButton" Style="{StaticResource Tool}" Content="收起" Click="Hide_OnClick" ToolTip="收起到顶部刘海 · Esc"
                            Tag="M4,15 L12,7 L20,15" AutomationProperties.Name="收起到顶部刘海"/>
                </StackPanel>
                <StackPanel x:Name="AnnotationTools" Orientation="Horizontal" Visibility="Collapsed">
                    <StackPanel Width="50" VerticalAlignment="Center" MouseLeftButtonDown="Drag_OnMouseDown" Cursor="SizeAll" Background="Transparent" ToolTip="拖动工具栏到上方或下方">
                        <TextBlock Text="Cue" FontFamily="Segoe UI Variable" FontSize="19" Foreground="#F3EFF9" FontWeight="SemiBold"/>
                        <TextBlock Text="标注" FontSize="9" Foreground="#AA9DBB"/>
                    </StackPanel>
                    <ToggleButton x:Name="PenTool" Style="{StaticResource AnnotationToggle}" Content="画笔" Click="AnnotationTool_OnClick" CommandParameter="Pen" ToolTip="自由画笔" Tag="M4,15 L15,4 L20,9 L9,20 L3,21 Z M13,6 L18,11"/>
                    <ToggleButton x:Name="HighlightTool" Style="{StaticResource AnnotationToggle}" Content="荧光" Click="AnnotationTool_OnClick" CommandParameter="Highlighter" ToolTip="半透明荧光笔" Tag="M7,14 L15,2 L22,7 L14,19 Z M7,14 L4,20 L10,20 L14,19 M2,23 L20,23"/>
                    <ToggleButton x:Name="ShapeTool" Style="{StaticResource AnnotationToggle}" Content="形状" Click="ShapeMenu_OnClick" ToolTip="箭头 / 直线 / 矩形 / 椭圆" Tag="M3,20 L20,3 M8,3 L20,3 L20,15"/>
                    <ToggleButton x:Name="TextTool" Style="{StaticResource AnnotationToggle}" Content="文字" Click="AnnotationTool_OnClick" CommandParameter="Text" ToolTip="单击输入；Enter 完成；双击文字编辑" Tag="M3,5 L21,5 M12,5 L12,22 M7,22 L17,22"/>
                    <ToggleButton x:Name="StepTool" Style="{StaticResource AnnotationToggle}" Content="编号" Click="AnnotationTool_OnClick" CommandParameter="Step" Tag="M12,2 A10,10 0 1 1 11.99,2 M9,9 L12,7 L12,17 M9,17 L15,17"/>
                    <Border Style="{StaticResource Divider}"/>
                    <Button x:Name="ColorTool" Style="{StaticResource AnnotationTool}" Content="颜色" Click="ColorMenu_OnClick" ToolTip="标注颜色" Tag="M12,2 A10,10 0 1 1 11.99,2 M8,12 L11,15 L17,8"/>
                    <Button x:Name="SizeTool" Style="{StaticResource AnnotationTool}" Content="4 px" Click="SizeMenu_OnClick" ToolTip="线宽" Tag="M3,5 L21,5 M3,12 L17,12 M3,19 L12,19"/>
                    <Border Style="{StaticResource Divider}"/>
                    <ToggleButton x:Name="EraseTool" Style="{StaticResource AnnotationToggle}" Content="橡皮" Click="AnnotationTool_OnClick" CommandParameter="Erase" ToolTip="点击删除完整对象，包括文字与箭头" Tag="M3,14 L14,3 L22,11 L12,21 L9,21 Z M8,9 L17,17 M12,21 L23,21"/>
                    <Button x:Name="UndoTool" Style="{StaticResource AnnotationTool}" Content="撤销" Click="Undo_OnClick" ToolTip="撤销 · Ctrl+Z" Tag="M4,8 A9,9 0 1 1 3,16 M4,2 L4,8 L10,8"/>
                    <Button x:Name="RedoTool" Style="{StaticResource AnnotationTool}" Content="重做" Click="Redo_OnClick" ToolTip="重做 · Ctrl+Y" Tag="M20,8 A9,9 0 1 0 21,16 M20,2 L20,8 L14,8"/>
                    <Button x:Name="MoreTool" Style="{StaticResource AnnotationTool}" Content="更多" Click="MoreMenu_OnClick" ToolTip="清空 / 复制图片 / 保存图片" Tag="M3,12 L5,12 M11,12 L13,12 M19,12 L21,12"/>
                    <Border Style="{StaticResource Divider}"/>
                    <ToggleButton x:Name="FreezeTool" Style="{StaticResource AnnotationToggle}" Width="48" Content="实时" Click="Freeze_OnClick" ToolTip="切换实时 / 冻结背景" Tag="M3,4 L21,4 L21,18 L3,18 Z M8,22 L16,22 M12,18 L12,22"/>
                    <ToggleButton x:Name="DesktopTool" Style="{StaticResource AnnotationToggle}" Content="桌面" Click="Desktop_OnClick" ToolTip="操作下方软件；会自动解除背景冻结" Tag="M5,2 L5,19 L10,14 L15,22 L18,20 L13,12 L21,11 Z"/>
                    <Button Style="{StaticResource AnnotationTool}" Content="退出" Click="ExitAnnotation_OnClick" ToolTip="退出标注 · 本次运行中保留内容" AutomationProperties.Name="退出标注" Tag="M10,3 L3,3 L3,21 L10,21 M9,12 L22,12 M16,6 L22,12 L16,18"/>
                    <Button Style="{StaticResource AnnotationTool}" Content="收起" Click="Hide_OnClick" ToolTip="收起到刘海；标注模式不会自动收起" Tag="M4,15 L12,7 L20,15"/>
                </StackPanel>
              </Grid>
            </Viewbox>
        </Border>
    </Grid>
</Window>
