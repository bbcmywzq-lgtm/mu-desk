<Window x:Class="PersonalToolbox.Views.CispQuestionBankWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CISP 题库 · MU Desk"
        Icon="{StaticResource MuCispQuestionBankIcon}"
        Width="1040"
        Height="760"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MuCanvasBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        Loaded="Window_OnLoaded">
    <Window.Resources>
        <SolidColorBrush x:Key="MuCanvasBrush" Color="#C9C7CC" />
        <SolidColorBrush x:Key="MuSurfaceBrush" Color="#E2DFE3" />
        <SolidColorBrush x:Key="MuSurfaceQuietBrush" Color="#D5D2D8" />
        <SolidColorBrush x:Key="MuInkBrush" Color="#2B2830" />
        <SolidColorBrush x:Key="MuMutedBrush" Color="#68636F" />
        <SolidColorBrush x:Key="MuOutlineBrush" Color="#4B4651" />
        <SolidColorBrush x:Key="MuLineBrush" Color="#B7B2BC" />
        <SolidColorBrush x:Key="MuAccentBrush" Color="#7650C8" />
        <SolidColorBrush x:Key="MuAccentSoftBrush" Color="#D6CBEA" />
        <SolidColorBrush x:Key="MuSuccessBrush" Color="#286D4D" />
        <SolidColorBrush x:Key="MuSuccessSoftBrush" Color="#CDE0D4" />
        <SolidColorBrush x:Key="MuDangerBrush" Color="#9B3F4B" />
        <SolidColorBrush x:Key="MuDangerSoftBrush" Color="#E4C9CF" />

        <Style x:Key="MuPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MuSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MuOutlineBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style x:Key="MuSecondaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Background" Value="{StaticResource MuSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MuInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MuOutlineBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource MuAccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#C8B8E3" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource MuAccentBrush}" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource MuComboBox}">
            <Setter Property="Background" Value="{StaticResource MuSurfaceQuietBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MuInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MuOutlineBrush}" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource MuTextBox}">
            <Setter Property="Background" Value="{StaticResource MuSurfaceQuietBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MuInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MuOutlineBrush}" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource MuCheckBox}">
            <Setter Property="Foreground" Value="{StaticResource MuInkBrush}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MuSurfaceBrush}"
                BorderBrush="{StaticResource MuOutlineBrush}" BorderThickness="0,0,0,1.5">
            <Grid Margin="28,18,28,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="54" Height="54" Background="{StaticResource MuAccentSoftBrush}"
                        BorderBrush="{StaticResource MuOutlineBrush}" BorderThickness="1.5" CornerRadius="14">
                    <Grid Margin="11">
                        <Rectangle RadiusX="4" RadiusY="4" Fill="{StaticResource MuSurfaceBrush}"
                                   Stroke="{StaticResource MuOutlineBrush}" StrokeThickness="1.5" />
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"
                                   FontWeight="Bold" Foreground="{StaticResource MuAccentBrush}" Text="C?" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource MuInkBrush}" Text="CISP 题库" />
                        <Border Margin="10,2,0,0" Padding="9,4" Background="{StaticResource MuAccentSoftBrush}" CornerRadius="10">
                            <TextBlock FontSize="11" Foreground="{StaticResource MuAccentBrush}" Text="普通 CISP · CISE/CISO" />
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MuMutedBrush}"
                               Text="公开题源转成交互练习；题干图片与原始材料一并保留。" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MuPrimaryButton}" Content="导出错题给 AI" Click="ExportWrongBook_OnClick" />
                    <Button Margin="9,0,0,0" Style="{StaticResource MuSecondaryButton}" Content="原版材料" Click="OpenPdfs_OnClick" />
                    <Button Margin="9,0,0,0" Style="{StaticResource MuSecondaryButton}" Content="查看题源" Click="OpenSource_OnClick" />
                    <Button Margin="9,0,0,0" Style="{StaticResource MuSecondaryButton}" Content="刷新题库" Click="Refresh_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ErrorBanner" Grid.Row="1" Margin="28,14,28,0" Padding="14,11"
                Background="{StaticResource MuDangerSoftBrush}" BorderBrush="{StaticResource MuDangerBrush}"
                BorderThickness="1.5" CornerRadius="12" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource MuDangerBrush}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2" Margin="28,18,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MuPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource MuInkBrush}" Text="练习设置" />
                    <TextBlock Margin="0,18,0,6" FontSize="12" Foreground="{StaticResource MuMutedBrush}" Text="练习入口" />
                    <ComboBox x:Name="PracticeModePicker" Padding="9,7" SelectionChanged="PracticeMode_OnChanged" />
                    <StackPanel x:Name="SetPickerPanel" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="{StaticResource MuMutedBrush}" Text="选择套题（各套独立）" />
                        <ComboBox x:Name="SetPicker" Padding="9,7" SelectionChanged="SetPicker_OnChanged" />
                        <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource MuAccentBrush}" Text="只从当前选中的一套题中练习，不会混入其他题。" />
                    </StackPanel>
                    <TextBlock Margin="0,14,0,6" FontSize="12" Foreground="{StaticResource MuMutedBrush}" Text="知识类别" />
                    <ComboBox x:Name="DomainPicker" Padding="9,7" SelectionChanged="Filter_OnChanged" />
                    <TextBlock x:Name="SessionSizeLabel" Margin="0,14,0,6" FontSize="12" Foreground="{StaticResource MuMutedBrush}" Text="每组题数（1–907）" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SessionSizeBox" Text="100" InputScope="Number"
                                 KeyDown="SessionSize_OnKeyDown" />
                        <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,8"
                                Style="{StaticResource MuSecondaryButton}" Content="应用"
                                Click="SessionSize_OnClick" />
                    </Grid>
                    <CheckBox x:Name="WrongOnlyToggle" Margin="0,16,0,0" Content="打开错题本"
                              Checked="Filter_OnChanged" Unchecked="Filter_OnChanged" />
                    <CheckBox x:Name="MarkedOnlyToggle" Margin="0,10,0,0" Content="只看标记题"
                              Checked="Filter_OnChanged" Unchecked="Filter_OnChanged" />
                    <CheckBox x:Name="ExcludedOnlyToggle" Margin="0,10,0,0" Content="管理不再抽取题"
                              Checked="Filter_OnChanged" Unchecked="Filter_OnChanged" />

                    <Border Margin="0,22,0,0" Padding="14" Background="{StaticResource MuSurfaceQuietBrush}"
                            BorderBrush="{StaticResource MuLineBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{StaticResource MuMutedBrush}" Text="当前题库" />
                            <TextBlock x:Name="QuestionCountText" Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource MuInkBrush}" Text="--" />
                            <TextBlock x:Name="SourceStateText" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource MuMutedBrush}" Text="正在读取公开题源…" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="14" Background="{StaticResource MuAccentSoftBrush}"
                            BorderBrush="{StaticResource MuLineBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{StaticResource MuMutedBrush}" Text="本机练习记录" />
                            <TextBlock x:Name="AttemptedText" Margin="0,6,0,0" Foreground="{StaticResource MuInkBrush}" Text="已做 0 题" />
                            <TextBlock x:Name="AccuracyText" Margin="0,4,0,0" Foreground="{StaticResource MuInkBrush}" Text="正确率 --" />
                            <TextBlock x:Name="WrongCountText" Margin="0,4,0,0" Foreground="{StaticResource MuDangerBrush}" Text="错题本 0 道" />
                            <TextBlock x:Name="MarkedCountText" Margin="0,4,0,0" Foreground="{StaticResource MuAccentBrush}" Text="标记 0 道" />
                            <TextBlock x:Name="ExcludedCountText" Margin="0,4,0,0" Foreground="{StaticResource MuMutedBrush}" Text="不再抽取 0 道" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource MuMutedBrush}"
                               Text="题库来自公开网络仓库，并非官方题库；部分题目可能较旧，请结合当前教材复核。" />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MuPanel}">
                <Grid>
                    <Grid x:Name="QuestionPanel" Margin="24,22,24,20" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="9,4" Background="{StaticResource MuAccentSoftBrush}" CornerRadius="10">
                                <TextBlock x:Name="DomainText" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource MuAccentBrush}" />
                            </Border>
                            <TextBlock x:Name="QuestionSourceText" Grid.Column="1" Margin="10,3,0,0" FontSize="11"
                                       Foreground="{StaticResource MuMutedBrush}" />
                            <Button x:Name="MarkButton" Grid.Column="2" Margin="12,-3,0,-3" Padding="9,4"
                                    Style="{StaticResource MuSecondaryButton}" Content="☆ 标记本题" Click="Mark_OnClick" />
                            <TextBlock x:Name="PositionText" Grid.Column="3" Margin="12,3,0,0" FontSize="11"
                                       Foreground="{StaticResource MuMutedBrush}" />
                        </Grid>

                        <TextBox x:Name="StemText" Grid.Row="1" Margin="0,18,0,18" Padding="0"
                                 FontSize="20" FontWeight="SemiBold" TextBlock.LineHeight="31"
                                 Foreground="{StaticResource MuInkBrush}" Background="Transparent" BorderThickness="0"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" TextWrapping="Wrap" />

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="OptionsPanel" />
                        </ScrollViewer>

                        <Border x:Name="AnswerPanel" Grid.Row="3" Margin="0,16,0,0" Padding="15,12"
                                BorderThickness="1.5" CornerRadius="12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="AnswerTitle" FontWeight="SemiBold" />
                                <TextBox x:Name="AnswerExplanation" Margin="0,6,0,0" Padding="0" TextWrapping="Wrap"
                                         Foreground="{StaticResource MuMutedBrush}" Background="Transparent" BorderThickness="0"
                                         IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="4" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ChooseHint" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource MuMutedBrush}" Text="文字可拖选复制；点 A–D 选答案。" />
                            <Button x:Name="RemoveWrongButton" Grid.Column="1" Margin="0,0,10,0"
                                    Style="{StaticResource MuSecondaryButton}" Content="已掌握，移出错题本"
                                    Click="RemoveWrong_OnClick" Visibility="Collapsed" />
                            <Button x:Name="ExcludeDrawButton" Grid.Column="2" Margin="0,0,10,0"
                                    Style="{StaticResource MuSecondaryButton}" Content="以后不再抽到"
                                    Click="ExcludeDraw_OnClick" Visibility="Collapsed" />
                            <Button x:Name="SubmitButton" Grid.Column="3" Style="{StaticResource MuPrimaryButton}"
                                    Content="提交答案" Click="Submit_OnClick" />
                            <Button x:Name="NextButton" Grid.Column="4" Margin="10,0,0,0" Style="{StaticResource MuSecondaryButton}"
                                    Content="随机下一题" Click="Next_OnClick" IsEnabled="False" />
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource MuInkBrush}"
                                   Text="正在准备题库" TextAlignment="Center" />
                        <TextBlock x:Name="EmptyText" Margin="0,8,0,0" MaxWidth="430" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource MuMutedBrush}" Text="首次打开会从公开仓库下载并缓存。" />
                    </StackPanel>

                    <Border x:Name="BusyOverlay" Background="{StaticResource MuSurfaceBrush}" CornerRadius="18">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="170" Height="5" IsIndeterminate="True" Foreground="{StaticResource MuAccentBrush}" />
                            <TextBlock Margin="0,13,0,0" Foreground="{StaticResource MuInkBrush}" Text="正在读取公开题库…" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource MuSurfaceBrush}"
                BorderBrush="{StaticResource MuLineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="28,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,9,0" Fill="{StaticResource MuAccentBrush}" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource MuMutedBrush}"
                           Text="题目和进度只缓存在本机。" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
