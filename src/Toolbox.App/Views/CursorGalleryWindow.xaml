<Window x:Class="PersonalToolbox.Views.CursorGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Tip · 光标装扮 · MU Desk"
        Icon="{StaticResource MuCursorGalleryIcon}"
        Width="1040"
        Height="740"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MuCanvasBrush}"
        FontFamily="Microsoft YaHei UI"
        FontSize="14"
        Loaded="Window_OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource MuSurfaceBrush}"
                BorderBrush="{StaticResource MuOutlineBrush}" BorderThickness="0,0,0,1.5">
            <Grid Margin="28,18,28,17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="54" Height="54" Background="{StaticResource MuAccentSoftBrush}"
                        BorderBrush="{StaticResource MuOutlineBrush}" BorderThickness="1.5" CornerRadius="14">
                    <Image Width="44" Height="44" Source="/Assets/CursorGallery/cursor-gallery-64.png" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                    <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource MuInkBrush}" Text="Tip · 光标装扮" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MuMutedBrush}"
                               Text="挑选一套皮肤，先看完整角色，再决定是否应用。" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Margin="0,0,12,0" Padding="11,7" Background="{StaticResource MuAccentSoftBrush}"
                            BorderBrush="{StaticResource MuLineBrush}" BorderThickness="1" CornerRadius="12">
                        <TextBlock x:Name="CurrentSchemeText" Foreground="{StaticResource MuInkBrush}" Text="正在读取当前方案…" />
                    </Border>
                    <Button Style="{StaticResource MuSecondaryButton}" Content="恢复 Windows 默认"
                            Click="Reset_OnClick" automation:AutomationProperties.Name="恢复 Windows 默认光标" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ErrorBanner" Grid.Row="1" Margin="28,14,28,0" Padding="14,11"
                Background="{StaticResource MuDangerSoftBrush}" BorderBrush="{StaticResource MuDangerBrush}"
                BorderThickness="1.5" CornerRadius="12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource MuDangerBrush}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" Text="!" />
                </Border>
                <TextBlock x:Name="ErrorText" Grid.Column="1" Margin="10,1,0,0" Foreground="{StaticResource MuDangerBrush}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="28,18,28,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="304" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MuPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="18,17,18,10">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource MuInkBrush}" Text="皮肤收藏" />
                        <TextBlock x:Name="CollectionCountText" Margin="0,4,0,0" FontSize="12"
                                   Foreground="{StaticResource MuMutedBrush}" Text="正在读取…" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="10,0,10,10">
                        <ListBox x:Name="SkinsList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource MuSkinListItem}"
                                 SelectionChanged="SkinsList_OnSelectionChanged"
                                 automation:AutomationProperties.Name="光标皮肤列表">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" Background="{StaticResource MuSurfaceBrush}"
                                                BorderBrush="{StaticResource MuLineBrush}" BorderThickness="1" CornerRadius="10"
                                                VerticalAlignment="Top">
                                            <Image Width="28" Height="28" Source="{Binding PreviewPath}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Margin="6,0,0,0" Padding="7,2"
                                                        Background="{StaticResource MuSuccessSoftBrush}" CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MuSuccessBrush}" Text="当前" />
                                                </Border>
                                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource MuInkBrush}"
                                                           Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource MuMutedBrush}"
                                                       Text="{Binding CompletenessLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="20" Visibility="Collapsed">
                            <Path Width="38" Height="44" Stretch="Uniform" Fill="{StaticResource MuAccentSoftBrush}"
                                  Stroke="{StaticResource MuOutlineBrush}" StrokeThickness="2"
                                  Data="M4,2 L4,38 L14,29 L21,43 L28,39 L21,26 L34,26 Z" />
                            <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" TextAlignment="Center"
                                       Foreground="{StaticResource MuInkBrush}" Text="还没有光标皮肤" />
                            <TextBlock Margin="0,5,0,0" Width="220" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource MuMutedBrush}" Text="MU Desk 没有找到可读取的 library.json。" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource MuPanel}">
                <Grid>
                    <Grid x:Name="NoSelectionPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource MuInkBrush}"
                                       Text="从左侧选择一套皮肤" TextAlignment="Center" />
                            <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MuMutedBrush}"
                                       Text="这里会显示它包含的全部光标角色。" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="DetailsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="22,20,22,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource MuInkBrush}"
                                               Text="{Binding Name}" />
                                    <Border Margin="10,2,0,0" Padding="8,3" Background="{StaticResource MuSuccessSoftBrush}"
                                            CornerRadius="9" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MuSuccessBrush}" Text="正在使用" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MuMutedBrush}" Text="{Binding CompletenessLabel}" />
                                <TextBlock Margin="0,5,0,0" MaxWidth="520" FontSize="12" Foreground="{StaticResource MuMutedBrush}"
                                           Text="{Binding ImportNote}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasImportNote}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Button x:Name="ApplyButton" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top"
                                    Style="{StaticResource MuPrimaryButton}" Content="应用这套皮肤" Click="Apply_OnClick"
                                    automation:AutomationProperties.Name="应用所选光标皮肤" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="22,0,12,18" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Roles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="142" Height="112" Margin="0,0,10,10" Padding="10"
                                                Background="{StaticResource MuSurfaceQuietBrush}" BorderBrush="{StaticResource MuLineBrush}"
                                                BorderThickness="1" CornerRadius="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="58" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Image Width="44" Height="44" Source="{Binding PreviewPath}" Stretch="Uniform">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Exists}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <Grid>
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Exists}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <Path Width="28" Height="34" Stretch="Uniform" Fill="{StaticResource MuAccentSoftBrush}"
                                                              Stroke="{StaticResource MuMutedBrush}" StrokeThickness="1.8"
                                                              Data="M4,2 L4,30 L12,23 L18,34 L23,31 L17,21 L27,21 Z" />
                                                        <Border Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Background="{StaticResource MuDangerSoftBrush}" CornerRadius="9">
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"
                                                                       FontWeight="Bold" Foreground="{StaticResource MuDangerBrush}" Text="!" />
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource MuInkBrush}" Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="10"
                                                               Foreground="{StaticResource MuMutedBrush}" Text="{Binding AvailabilityLabel}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="LoadingOverlay" Grid.ColumnSpan="3" Background="#CCF2F2F5" CornerRadius="18">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="150" Height="5" IsIndeterminate="True" Foreground="{StaticResource MuAccentBrush}" />
                    <TextBlock Margin="0,13,0,0" Foreground="{StaticResource MuInkBrush}" Text="正在读取光标库…" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource MuSurfaceBrush}"
                BorderBrush="{StaticResource MuLineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="28,11">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,9,0" Fill="{StaticResource MuAccentBrush}" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource MuMutedBrush}"
                           Text="正在准备 Tip。" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
