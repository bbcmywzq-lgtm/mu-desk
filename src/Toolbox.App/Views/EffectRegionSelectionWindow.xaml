<Window x:Class="PersonalToolbox.Views.EffectRegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        Cursor="Cross" KeyDown="Window_OnKeyDown">
    <Canvas x:Name="RootCanvas" Background="Transparent"
            MouseLeftButtonDown="Canvas_OnMouseLeftButtonDown"
            MouseMove="Canvas_OnMouseMove"
            MouseLeftButtonUp="Canvas_OnMouseLeftButtonUp">
        <Rectangle x:Name="ShadeTop" Fill="#A012141B" />
        <Rectangle x:Name="ShadeLeft" Fill="#A012141B" />
        <Rectangle x:Name="ShadeRight" Fill="#A012141B" />
        <Rectangle x:Name="ShadeBottom" Fill="#A012141B" />

        <Border x:Name="SelectionBorder" Visibility="Collapsed"
                BorderBrush="#C8ADFF" BorderThickness="2" CornerRadius="3"
                Background="#01000000">
            <Grid>
                <Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="-4" BorderBrush="White" BorderThickness="2,2,0,0" />
                <Border Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="-4" BorderBrush="White" BorderThickness="0,2,2,0" />
                <Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="-4" BorderBrush="White" BorderThickness="2,0,0,2" />
                <Border Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="-4" BorderBrush="White" BorderThickness="0,0,2,2" />
            </Grid>
        </Border>

        <Border x:Name="InstructionPanel" Canvas.Left="24" Canvas.Top="24"
                Padding="14,10" CornerRadius="8" Background="#E61A1C24"
                BorderBrush="#55FFFFFF" BorderThickness="1">
            <TextBlock Foreground="White" FontFamily="Microsoft YaHei UI"
                       Text="拖动选择要记录的区域 · Esc 取消" />
        </Border>

        <Border x:Name="Toolbar" Visibility="Collapsed" Padding="10" CornerRadius="10"
                Background="#F21A1C24" BorderBrush="#55FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="2,0,10,0" Foreground="#D9FFFFFF" Text="录制" />
                <ComboBox x:Name="DurationBox" Width="76" Height="32" SelectedValuePath="Tag">
                    <ComboBoxItem Content="2 秒" Tag="2" />
                    <ComboBoxItem Content="5 秒" Tag="5" />
                    <ComboBoxItem Content="7 秒" Tag="7" />
                </ComboBox>
                <Button Margin="10,0,0,0" Padding="15,6" Background="#8055D9" Foreground="White"
                        BorderBrush="#A77CF0" Content="开始录制" Click="Start_OnClick" />
                <Button Margin="8,0,0,0" Padding="12,6" Background="#272A34" Foreground="White"
                        BorderBrush="#555A68" Content="重选" Click="Reselect_OnClick" />
                <Button Margin="8,0,0,0" Padding="12,6" Background="#272A34" Foreground="White"
                        BorderBrush="#555A68" Content="取消" Click="Cancel_OnClick" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
