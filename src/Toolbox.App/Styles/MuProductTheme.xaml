<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="MuCanvasColor">#F2F2F5</Color>
    <Color x:Key="MuSurfaceColor">#FFFCF8</Color>
    <Color x:Key="MuSurfaceQuietColor">#F7F5F3</Color>
    <Color x:Key="MuInkColor">#252329</Color>
    <Color x:Key="MuMutedColor">#747079</Color>
    <Color x:Key="MuOutlineColor">#343139</Color>
    <Color x:Key="MuLineColor">#DAD6DE</Color>
    <Color x:Key="MuAccentColor">#7A4FD3</Color>
    <Color x:Key="MuAccentSoftColor">#EEE7FA</Color>
    <Color x:Key="MuSuccessColor">#267650</Color>
    <Color x:Key="MuSuccessSoftColor">#E8F4ED</Color>
    <Color x:Key="MuDangerColor">#A8424A</Color>
    <Color x:Key="MuDangerSoftColor">#FBEAEC</Color>

    <SolidColorBrush x:Key="MuCanvasBrush" Color="{StaticResource MuCanvasColor}" />
    <SolidColorBrush x:Key="MuSurfaceBrush" Color="{StaticResource MuSurfaceColor}" />
    <SolidColorBrush x:Key="MuSurfaceQuietBrush" Color="{StaticResource MuSurfaceQuietColor}" />
    <SolidColorBrush x:Key="MuInkBrush" Color="{StaticResource MuInkColor}" />
    <SolidColorBrush x:Key="MuMutedBrush" Color="{StaticResource MuMutedColor}" />
    <SolidColorBrush x:Key="MuOutlineBrush" Color="{StaticResource MuOutlineColor}" />
    <SolidColorBrush x:Key="MuLineBrush" Color="{StaticResource MuLineColor}" />
    <SolidColorBrush x:Key="MuAccentBrush" Color="{StaticResource MuAccentColor}" />
    <SolidColorBrush x:Key="MuAccentSoftBrush" Color="{StaticResource MuAccentSoftColor}" />
    <SolidColorBrush x:Key="MuSuccessBrush" Color="{StaticResource MuSuccessColor}" />
    <SolidColorBrush x:Key="MuSuccessSoftBrush" Color="{StaticResource MuSuccessSoftColor}" />
    <SolidColorBrush x:Key="MuDangerBrush" Color="{StaticResource MuDangerColor}" />
    <SolidColorBrush x:Key="MuDangerSoftBrush" Color="{StaticResource MuDangerSoftColor}" />

    <DrawingImage x:Key="MuCispQuestionBankIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource MuAccentSoftBrush}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuOutlineBrush}" Thickness="3.5" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="2,2,60,60" RadiusX="13" RadiusY="13" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="Transparent" Geometry="M31,18 C25,11 11,14 11,31 C11,48 26,51 33,41">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuAccentBrush}" Thickness="6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="Transparent" Geometry="M38,20 C40,12 55,13 55,25 C55,33 47,34 47,42">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuAccentBrush}" Thickness="6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource MuAccentBrush}">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="47,51" RadiusX="3.5" RadiusY="3.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="MuEffectCaptureIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent"
                                 Geometry="M20,4 L5,4 L5,19 M44,4 L59,4 L59,19 M5,45 L5,60 L20,60 M59,45 L59,60 L44,60">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuOutlineBrush}" Thickness="4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource MuAccentBrush}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuOutlineBrush}" Thickness="3.5" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="18,23,28,19" RadiusX="4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource MuSurfaceBrush}" Geometry="M30,27 L40,32.5 L30,38 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="MuCueIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource MuSurfaceBrush}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuOutlineBrush}" Thickness="3.5" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="4,8,56,43" RadiusX="9" RadiusY="9" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="Transparent" Geometry="M20,16 L13,16 L13,23 M44,16 L51,16 L51,23 M13,36 L13,43 L20,43 M51,36 L51,43 L44,43">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuAccentBrush}" Thickness="4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource MuAccentBrush}" Geometry="M25,20 L25,44 L31,37 L37,49 L43,46 L37,34 L47,34 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuOutlineBrush}" Thickness="2.5" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource MuOutlineBrush}" Geometry="M25,56 L39,56 L36,51 L28,51 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="MuCursorGalleryIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource MuSurfaceBrush}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuOutlineBrush}" Thickness="3.5" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="4,4,35,35" RadiusX="8" RadiusY="8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource MuAccentBrush}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuOutlineBrush}" Thickness="3.5" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="26,26,34,34" RadiusX="8" RadiusY="8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource MuSurfaceBrush}" Geometry="M12,10 L12,50 L23,40 L32,57 L40,53 L31,36 L47,36 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuOutlineBrush}" Thickness="3.5" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="MuFileShelfIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource MuSurfaceBrush}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuOutlineBrush}" Thickness="3" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="7,6,18,37" RadiusX="4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource MuAccentSoftBrush}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuOutlineBrush}" Thickness="3" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="24,2,21,41" RadiusX="4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource MuSurfaceBrush}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuOutlineBrush}" Thickness="3" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="43,10,14,33" RadiusX="4" RadiusY="4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource MuAccentBrush}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuOutlineBrush}" Thickness="3.5" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="3,35,58,14" RadiusX="5" RadiusY="5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource MuSurfaceBrush}" Geometry="M8,48 L56,48 L52,59 L12,59 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource MuOutlineBrush}" Thickness="3.5" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <Style x:Key="MuPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MuSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MuOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <Style x:Key="MuPrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Background" Value="{StaticResource MuAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource MuOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#6840BE" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="RenderTransformOrigin" Value="0.5,0.5" />
                            <Setter TargetName="Surface" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#1F1D23" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MuSecondaryButton" TargetType="Button" BasedOn="{StaticResource MuPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource MuSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MuInkBrush}" />
        <Setter Property="Padding" Value="15,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource MuAccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#E3D8F5" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource MuAccentBrush}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MuTextBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource MuSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MuInkBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource MuInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MuOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="SelectionBrush" Value="{StaticResource MuAccentSoftBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource MuAccentBrush}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.48" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MuComboBox" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource MuSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource MuInkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource MuOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1.2" />
    </Style>

    <Style x:Key="MuCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource MuInkBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="MuSkinListItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Surface" Padding="12" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="12">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource MuSurfaceQuietBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource MuLineBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource MuAccentSoftBrush}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource MuAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource MuOutlineBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
