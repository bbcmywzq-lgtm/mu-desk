<Application x:Class="PersonalToolbox.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DesktopOrganizer;component/Themes/DesktopOrganizerResources.xaml" />
                <ResourceDictionary Source="Styles/MuProductTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="InkBrush" Color="#25252A" />
        <SolidColorBrush x:Key="MutedBrush" Color="#73737D" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8055D9" />
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Background" Value="#FAFAFC" />
            <Setter Property="Foreground" Value="#25252A" />
            <Setter Property="BorderBrush" Value="#343139" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEE7FA" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#8055D9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E3D8F5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
