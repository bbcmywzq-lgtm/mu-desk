<Window x:Class="DesktopOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Grid · 桌面整理"
        Width="1280"
        Height="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Grid>
        <Border x:Name="FocusBackdrop"
                Background="#38090712"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed" />
        <Canvas x:Name="WorkspaceCanvas" Background="{x:Null}" />

        <Border x:Name="CommandToolbar"
                Margin="0,22,26,0"
                Padding="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#A61B2533"
                BorderBrush="#45FFFFFF"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  Direction="270"
                                  Opacity="0.3"
                                  ShadowDepth="8" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Width="34"
                        Height="34"
                        Margin="0,0,4,0"
                        Background="#12FFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="9"
                        ToolTip="Grid · 让桌面各得其所">
                    <Grid Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Margin="0,0,2,2" Background="#55FFFFFF" CornerRadius="2" />
                        <Border Grid.Column="1" Margin="2,0,0,2" Background="#2EFFFFFF" CornerRadius="2" />
                        <Border Grid.Row="1" Margin="0,2,2,0" Background="#2EFFFFFF" CornerRadius="2" />
                        <Border Grid.Row="1" Grid.Column="1" Margin="2,2,0,0" Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                    </Grid>
                </Border>
                <Border Width="210"
                        Height="34"
                        Margin="2,0,4,0"
                        Background="#18FFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Width="14"
                              Height="14"
                              Data="M 8,1 A 7,7 0 1 0 8,15 A 7,7 0 1 0 8,1 M 13,13 L 18,18"
                              Stretch="Uniform"
                              Stroke="#AFC7D5E8"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="1"
                                 Padding="0,1,0,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 CaretBrush="White"
                                 Foreground="White"
                                 FontFamily="Segoe UI Variable Text"
                                 FontSize="12"
                                 ToolTip="搜索所有分区中的文件"
                                 automation:AutomationProperties.Name="搜索所有文件"
                                 TextChanged="OnSearchTextChanged"
                                 KeyDown="OnSearchKeyDown" />
                        <TextBlock x:Name="SearchHint"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Foreground="#7FC7D5E8"
                                   FontSize="12"
                                   IsHitTestVisible="False"
                                   Text="搜索所有文件" />
                        <Button x:Name="ClearSearchButton"
                                Grid.Column="2"
                                Width="24"
                                Height="24"
                                Margin="0,0,3,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Content="×"
                                Cursor="Hand"
                                Foreground="#AFC7D5E8"
                                FontSize="15"
                                ToolTip="清除搜索"
                                Visibility="Collapsed"
                                Click="OnClearSearchClick" />
                    </Grid>
                </Border>
                <Border Width="1" Margin="4,6" Background="#26FFFFFF" />
                <Button Padding="10,7"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#C7D0DC"
                        Cursor="Hand"
                        ToolTip="立即应用自动整理规则"
                        automation:AutomationProperties.Name="立即自动整理"
                        Click="OnApplyRulesClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" FontSize="14" Text="✦" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="整理" />
                    </StackPanel>
                </Button>
                <Border Width="1" Margin="4,6" Background="#26FFFFFF" />
                <Button x:Name="UndoButton"
                        Padding="10,7"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#C7D0DC"
                        Cursor="Hand"
                        IsEnabled="False"
                        ToolTip="撤销上一次整理操作"
                        automation:AutomationProperties.Name="撤销上一次整理操作"
                        Click="OnUndoClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" FontSize="16" Text="↶" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="撤销" />
                    </StackPanel>
                </Button>
                <Border Width="1" Margin="4,6" Background="#26FFFFFF" />
                <Button x:Name="NewZoneButton"
                        Padding="12,7"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        Cursor="Hand"
                        ToolTip="新建桌面收纳分区或智能文件夹分区"
                        Click="OnNewZoneMenuClick">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="桌面收纳分区" Click="OnNewDesktopZoneClick" />
                            <MenuItem Header="智能文件夹分区…" Click="OnNewSmartZoneClick" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,7,0" FontSize="17" Text="＋" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="新建分区" />
                    </StackPanel>
                </Button>
                <Border Width="1" Margin="4,6" Background="#26FFFFFF" />
                <Button Padding="12,7"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#C7D0DC"
                        Cursor="Hand"
                        ToolTip="恢复默认收件箱布局"
                        Click="OnResetLayoutClick"
                        Content="重置布局" />
                <Border Width="1" Margin="4,6" Background="#26FFFFFF" />
                <Button Padding="11,7"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#C7D0DC"
                        Cursor="Hand"
                        ToolTip="设置"
                        automation:AutomationProperties.Name="打开设置"
                        Click="OnSettingsClick"
                        Content="设置" />
            </StackPanel>
        </Border>

        <Border x:Name="FocusModeIndicator"
                Margin="26,22,0,0"
                Padding="12,7"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#E51A1725"
                BorderBrush="#668B7CFF"
                BorderThickness="1"
                CornerRadius="14"
                Cursor="Hand"
                ToolTip="单击或按 Esc 退出视域"
                Visibility="Collapsed"
                MouseLeftButtonDown="OnExitFocusModeMouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" Direction="270" Opacity="0.32" ShadowDepth="6" Color="#FF4A36A8" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}" CornerRadius="4" />
                <TextBlock x:Name="FocusModeText"
                           VerticalAlignment="Center"
                           Foreground="#FFF2EFFF"
                           FontFamily="Segoe UI Variable Text"
                           FontSize="11"
                           Text="视域" />
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#92CFC9DC"
                           FontSize="10"
                           Text="Esc 退出" />
            </StackPanel>
        </Border>

        <Border x:Name="OperationToast"
                Margin="0,0,0,32"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#EB172231"
                BorderBrush="#668B7CFF"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Direction="270" Opacity="0.35" ShadowDepth="8" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="OperationToastText"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="12" />
                <Button x:Name="OperationToastUndoButton"
                        Margin="14,0,0,0"
                        Padding="10,4"
                        Background="#268B7CFF"
                        BorderBrush="#608B7CFF"
                        Foreground="#FFEDE9FF"
                        Cursor="Hand"
                        Content="撤销"
                        Click="OnToastUndoClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
