<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DesktopOrganizer</AssemblyName>
    <RootNamespace>DesktopOrganizer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DesktopOrganizer.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <Version>1.4.0</Version>
    <AssemblyTitle>Mujun Grid</AssemblyTitle>
    <Product>Mujun Grid</Product>
    <Description>Grid：本地优先的 Windows 桌面视域整理工具</Description>
    <Authors>mujun</Authors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopOrganizer.Core\DesktopOrganizer.Core.csproj" />
    <ProjectReference Include="..\Toolbox.Core\Toolbox.Core.csproj" />
  </ItemGroup>
</Project>
