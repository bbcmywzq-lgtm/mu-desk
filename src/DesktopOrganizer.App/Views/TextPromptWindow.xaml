<Window x:Class="DesktopOrganizer.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="430"
        Height="210"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF101721"
        Foreground="#FFF5F7FA"
        FontFamily="Segoe UI Variable Text">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" FontSize="14" FontWeight="SemiBold" />
        <TextBox x:Name="ValueTextBox"
                 Grid.Row="1"
                 Height="38"
                 Margin="0,14,0,0"
                 Padding="10,5"
                 VerticalContentAlignment="Center"
                 Background="#1AFFFFFF"
                 BorderBrush="#608B7CFF"
                 Foreground="White"
                 CaretBrush="White" />
        <StackPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="78" Height="34" Margin="0,0,10,0" Content="取消" IsCancel="True" />
            <Button Width="78" Height="34" Background="#FF8B7CFF" Foreground="White" Content="确定" IsDefault="True" Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</Window>
