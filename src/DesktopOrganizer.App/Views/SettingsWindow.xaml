<Window x:Class="DesktopOrganizer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grid · 桌面整理 · MU Desk"
        Width="780"
        Height="680"
        MinWidth="700"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#FFEEF0F5"
        Foreground="#FF25252A"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#FFFAFAFC" />
            <Setter Property="BorderBrush" Value="#FF343139" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Foreground" Value="#FF25252A" />
            <Setter Property="CaretBrush" Value="#FF25252A" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#FFFAFAFC" />
            <Setter Property="Foreground" Value="#FF25252A" />
            <Setter Property="BorderBrush" Value="#FF343139" />
            <Setter Property="BorderThickness" Value="1.2" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="Foreground" Value="#FF25252A" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Background" Value="#FF8055D9" />
            <Setter Property="BorderBrush" Value="#FF6840BE" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.2" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FF6840BE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="#FFFAFAFC" />
            <Setter Property="BorderBrush" Value="#FF343139" />
            <Setter Property="Foreground" Value="#FF25252A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.2" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FF8055D9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFAFAFC" BorderBrush="#FFDAD6DE" BorderThickness="0,0,0,1">
            <StackPanel Margin="28,18">
                <TextBlock FontSize="22" FontWeight="SemiBold" Text="设置" />
                <TextBlock Margin="0,5,0,0"
                           Foreground="#FF73737D"
                           FontSize="12"
                           Text="所有设置和规则只保存在本机" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22">
                <Border Padding="20"
                        Background="#FFFAFAFC"
                        BorderBrush="#FF343139"
                        BorderThickness="1.2"
                        CornerRadius="14">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="常规" />
                        <CheckBox x:Name="AutoApplyRulesCheckBox"
                                  Margin="0,15,0,5"
                                  Content="桌面内容变化后自动应用整理规则" />
                        <CheckBox x:Name="ShowToolbarCheckBox" Content="显示桌面顶部工具条" />
                        <CheckBox x:Name="HideNativeIconsCheckBox" Content="隐藏 Windows 原生桌面图标，避免重复显示" />
                        <CheckBox x:Name="LaunchAtStartupCheckBox" Content="登录 Windows 后自动启动" />
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="20"
                        Background="#FFFAFAFC"
                        BorderBrush="#FF343139"
                        BorderThickness="1.2"
                        CornerRadius="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="自动整理规则" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="#FF73737D"
                                           FontSize="11"
                                           Text="手动拖放始终优先于自动规则" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="新增规则"
                                        Click="OnAddRuleClick" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="删除"
                                        Click="OnDeleteRuleClick" />
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="RulesList"
                                 Height="132"
                                 Margin="0,16,0,16"
                                 Padding="4"
                                 Background="#FFF7F5F3"
                                 Foreground="#FF25252A"
                                 BorderBrush="#FFDAD6DE"
                                 DisplayMemberPath="Name"
                                 SelectionChanged="OnRuleSelectionChanged" />

                        <Grid x:Name="RuleEditor">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44" />
                                <RowDefinition Height="44" />
                                <RowDefinition Height="44" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Foreground="#FF73737D" Text="规则名称" />
                            <TextBox x:Name="RuleNameTextBox" Grid.Row="0" Grid.Column="1" />
                            <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Foreground="#FF73737D" Text="目标分区" />
                            <ComboBox x:Name="TargetZoneComboBox"
                                      Grid.Row="0"
                                      Grid.Column="4"
                                      DisplayMemberPath="Name" />

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="#FF73737D" Text="匹配方式" />
                            <ComboBox x:Name="MatchKindComboBox"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      DisplayMemberPath="DisplayName" />
                            <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Foreground="#FF73737D" Text="匹配内容" />
                            <TextBox x:Name="PatternTextBox"
                                     Grid.Row="1"
                                     Grid.Column="4"
                                     ToolTip="例如 .pdf 或 报告" />

                            <CheckBox x:Name="RuleEnabledCheckBox"
                                      Grid.Row="2"
                                      Grid.ColumnSpan="2"
                                      VerticalAlignment="Center"
                                      Content="启用此规则" />
                            <Button Grid.Row="2"
                                    Grid.Column="4"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="更新规则"
                                    Click="OnUpdateRuleClick" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="20"
                        Background="#FFFAFAFC"
                        BorderBrush="#FF343139"
                        BorderThickness="1.2"
                        CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="本地数据" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="#FF73737D"
                                       FontSize="11"
                                       Text="布局、设置、备份和诊断日志" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="导出备份"
                                    Click="OnExportBackupClick" />
                            <Button Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="导入备份"
                                    Click="OnImportBackupClick" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="打开目录"
                                    Click="OnOpenDataDirectoryClick" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FFFAFAFC" BorderBrush="#FFDAD6DE" BorderThickness="0,1,0,0">
            <StackPanel Margin="28,16" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="取消"
                        IsCancel="True" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="保存并应用"
                        IsDefault="True"
                        Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
