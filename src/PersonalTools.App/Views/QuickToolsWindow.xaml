<Window x:Class="PersonalTools.App.Views.QuickToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memo · 随记提醒 · MU Desk" Icon="/Assets/ReminderNotes.ico"
        Width="940" Height="680" MinWidth="780" MinHeight="570"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#F3F1F5" Foreground="#2E2933"
        FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#7650A6" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EDE4F7" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="Foreground" Value="#4D4258" />
      <Setter Property="Background" Value="#F6F2F9" />
      <Setter Property="BorderBrush" Value="#D2C6DC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}" CornerRadius="8"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#EBE1F4" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#DDCEEB" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="ReminderNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
      <Setter Property="Margin" Value="10,0,0,3" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#6F6675" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D8D0DE" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D8D0DE" />
    </Style>
    <Style x:Key="ColorDot" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="BorderBrush" Value="#B9ADBF" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Width="20" Height="20" CornerRadius="10" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemBorder" Padding="11" CornerRadius="10"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#F8F5FA" />
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#DED4E6" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="White" />
                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#9B7ABB" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="174" />
      <ColumnDefinition Width="310" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Background="#FBFAFC" BorderBrush="#DDD6E2" BorderThickness="0,0,1,0">
      <Grid Margin="16,18,14,15">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="4,0,4,18">
          <TextBlock FontSize="24" FontWeight="SemiBold" Text="Memo" ToolTip="Mujun Memo" />
          <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#817888" Text="随记提醒 · 桌面便签" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,17">
          <Button Style="{StaticResource PrimaryButton}" Content="＋ 新建随记" Click="OnNewNoteClick" />
        </StackPanel>

        <StackPanel x:Name="FilterButtonsPanel" Grid.Row="2">
          <TextBlock Margin="10,0,0,7" FontSize="10" Foreground="#92899A" Text="随记" />
          <Button Style="{StaticResource NavButton}" Tag="全部" Content="全部随记" Click="OnFilterButtonClick" />
          <Button Style="{StaticResource NavButton}" Tag="桌面便签" Content="桌面便签" Click="OnFilterButtonClick" />
          <Button Style="{StaticResource NavButton}" Tag="收藏" Content="收藏" Click="OnFilterButtonClick" />
          <Button Style="{StaticResource NavButton}" Tag="已归档" Content="已归档" Click="OnFilterButtonClick" />
          <TextBlock Margin="10,13,0,7" FontSize="10" Foreground="#92899A" Text="提醒" />
          <Button Style="{StaticResource ReminderNavButton}" Tag="今天" Content="今天" Click="OnFilterButtonClick" />
          <Button Style="{StaticResource ReminderNavButton}" Tag="待提醒" Content="待提醒" Click="OnFilterButtonClick" />
          <Button Style="{StaticResource ReminderNavButton}" Tag="已完成" Content="已完成" Click="OnFilterButtonClick" />
        </StackPanel>

        <Border Grid.Row="3" Padding="10" CornerRadius="10" Background="#F2EDF6">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock FontWeight="SemiBold" Text="桌面便签" />
              <TextBlock x:Name="DesktopCountText" DockPanel.Dock="Right" Foreground="#806E90" Text="0 张" />
            </DockPanel>
            <Button x:Name="ToggleCardsButton" Padding="8,5" Content="隐藏全部" Click="OnToggleCardsClick" />
            <Button Margin="0,6,0,0" Padding="7,5" Content="自动排列" Click="OnArrangeCardsClick" />
            <Button Margin="0,6,0,0" Padding="7,5" Content="救回屏幕外" Click="OnRescueCardsClick" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Column="1" Background="#F5F3F7" BorderBrush="#DDD6E2" BorderThickness="0,0,1,0">
      <Grid Margin="15,18,14,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="2,0,2,12">
          <Border DockPanel.Dock="Right" Padding="9,4" CornerRadius="11" Background="#EAE1F3">
            <TextBlock x:Name="CountText" FontSize="11" Foreground="#7650A6" Text="0 条" />
          </Border>
          <TextBlock x:Name="ListTitleText" FontSize="18" FontWeight="SemiBold" Text="全部随记" />
        </DockPanel>
        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,12" ToolTip="搜索内容或标签"
                 TextChanged="OnSearchChanged" />
        <ListBox x:Name="EntryList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                 SelectionChanged="OnEntrySelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="5" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="3" Background="{Binding ColorBrush}" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="10" Foreground="#7650A6"
                               Text="{Binding Markers}" />
                    <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <TextBlock Margin="0,4,0,0" Height="34" Foreground="#706876" FontSize="11"
                             Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                  <TextBlock Margin="0,5,0,0" Foreground="#968C9B" FontSize="10" Text="{Binding Meta}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyListText" Grid.Row="3" Margin="2,8,2,0" Foreground="#847A89"
                   Text="这里还没有随记。" Visibility="Collapsed" />
      </Grid>
    </Border>

    <Grid Grid.Column="2">
      <StackPanel x:Name="EditorPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="54" Height="54" CornerRadius="16" Background="#EAE1F3">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="27" Foreground="#7650A6" Text="＋" />
        </Border>
        <TextBlock Margin="0,15,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="选择或新建一条随记" />
        <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" Foreground="#857B8A" Text="内容会自动保存" />
      </StackPanel>

      <ScrollViewer x:Name="EditorPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,18">
          <Grid Margin="0,0,0,13">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="EditorHeadingText" FontSize="19" FontWeight="SemiBold" Text="新随记" />
              <TextBlock x:Name="EditorStatusText" Margin="0,3,0,0" FontSize="10.5" Foreground="#817789" Text="输入后自动保存" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="FavoriteButton" Padding="9,5" Content="☆ 收藏" Click="OnFavoriteClick" />
              <Button x:Name="PinButton" Margin="7,0,0,0" Padding="9,5" Content="贴到桌面" Click="OnPinClick" />
            </StackPanel>
          </Grid>

          <TextBox x:Name="EntryContentBox" MinHeight="215" Padding="14" AcceptsReturn="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="15"
                   TextChanged="OnEditorContentChanged" PreviewKeyDown="OnContentKeyDown" />

          <Border Margin="0,14,0,0" Padding="14,11" CornerRadius="10" Background="#FAF8FB"
                  BorderBrush="#DED6E4" BorderThickness="1">
            <StackPanel>
              <TextBlock Margin="0,0,0,9" FontSize="10" Foreground="#92899A" Text="随记属性" />
              <CheckBox x:Name="ReminderToggle" Visibility="Collapsed"
                        Checked="OnReminderToggleChanged" Unchecked="OnReminderToggleChanged" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="8" Background="#EEE6F5">
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="#7650A6" Text="◷" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                  <TextBlock FontWeight="SemiBold" Text="提醒" />
                  <TextBlock x:Name="ReminderSummaryText" Margin="0,2,0,0" FontSize="10.5" Foreground="#827889" Text="未设置" />
                </StackPanel>
                <Button x:Name="RemoveReminderButton" Grid.Column="2" Margin="0,0,6,0" Padding="7,4"
                        Foreground="#8B6570" Content="移除" Visibility="Collapsed" Click="OnRemoveReminderClick" />
                <Button x:Name="ReminderEditButton" Grid.Column="3" Padding="9,5" Content="添加" Click="OnReminderEditClick" />
              </Grid>
              <StackPanel x:Name="ReminderPanel" Margin="38,11,0,2" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <DatePicker x:Name="DueDatePicker" Height="34" VerticalAlignment="Top" />
                  <TextBox x:Name="DueTimeBox" Grid.Column="1" Height="34" Margin="8,0,0,0" Padding="8,6" MaxLength="5" Text="09:00" />
                  <Button Grid.Column="2" HorizontalAlignment="Right" Padding="10,6" Content="应用" Click="OnApplyReminderClick" />
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                  <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#756B7B" Text="快捷" />
                  <Button Padding="7,5" Content="10分钟" Tag="10" Click="OnPresetClick" />
                  <Button Margin="5,0,0,0" Padding="7,5" Content="1小时" Tag="60" Click="OnPresetClick" />
                  <Button Margin="5,0,0,0" Padding="7,5" Content="明早" Tag="tomorrow9" Click="OnPresetClick" />
                </WrapPanel>
                <DockPanel Margin="0,8,0,0">
                  <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#756B7B" Text="重复" />
                  <ComboBox x:Name="RepeatBox" Width="122" HorizontalAlignment="Left" SelectedIndex="0">
                    <ComboBoxItem Content="不重复" />
                    <ComboBoxItem Content="每天" />
                    <ComboBoxItem Content="工作日" />
                    <ComboBoxItem Content="每周" />
                  </ComboBox>
                </DockPanel>
              </StackPanel>
              <Border Margin="0,11,0,10" Height="1" Background="#E6DFE9" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="58" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="#756B7B" Text="标签" />
                <TextBox x:Name="TagsBox" Grid.Column="1" Padding="8,6" ToolTip="用逗号分隔"
                         TextChanged="OnTagsChanged" LostKeyboardFocus="OnTagsLostFocus" />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="58" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="#756B7B" Text="便签色" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Style="{StaticResource ColorDot}" Background="#FFF1A8" Tag="yellow" ToolTip="便签黄" Click="OnColorClick" />
                  <Button Style="{StaticResource ColorDot}" Background="#DCC7F4" Tag="violet" ToolTip="淡紫" Click="OnColorClick" />
                  <Button Style="{StaticResource ColorDot}" Background="#BFE5C9" Tag="mint" ToolTip="薄荷" Click="OnColorClick" />
                  <Button Style="{StaticResource ColorDot}" Background="#BED9F1" Tag="blue" ToolTip="浅蓝" Click="OnColorClick" />
                  <Button Style="{StaticResource ColorDot}" Background="#F0C8CF" Tag="rose" ToolTip="柔粉" Click="OnColorClick" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Separator Margin="0,15,0,13" Background="#DDD5E2" />
          <DockPanel>
            <Button x:Name="DeleteButton" DockPanel.Dock="Right" Padding="9,5" Foreground="#A44C5B" Content="删除" Click="OnDeleteClick" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="CompleteActionButton" Content="标记完成" Click="OnCompleteClick" />
              <Button x:Name="ArchiveActionButton" Margin="7,0,0,0" Content="归档" Click="OnArchiveClick" />
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </ScrollViewer>

      <Border VerticalAlignment="Bottom" Margin="22,0,22,12" Background="Transparent">
        <TextBlock x:Name="GlobalStatusText" FontSize="11" Foreground="#756C7B" />
      </Border>
    </Grid>
  </Grid>
</Window>
