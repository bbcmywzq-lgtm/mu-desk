<Window x:Class="MouseRing.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit · 快捷轮盘 · MU Desk"
        Width="520"
        Height="650"
        MinWidth="480"
        MinHeight="610"
        WindowStartupLocation="CenterScreen"
        Background="#EEF0F5"
        Foreground="#25252A"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="MuSurfaceBrush" Color="#FAFAFC" />
        <SolidColorBrush x:Key="MuInkBrush" Color="#25252A" />
        <SolidColorBrush x:Key="MuMutedBrush" Color="#73737D" />
        <SolidColorBrush x:Key="MuOutlineBrush" Color="#343139" />
        <SolidColorBrush x:Key="MuLineBrush" Color="#DAD6DE" />
        <SolidColorBrush x:Key="MuAccentBrush" Color="#8055D9" />
        <SolidColorBrush x:Key="MuAccentSoftBrush" Color="#E9DEFF" />
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource MuSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MuInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MuOutlineBrush}" />
            <Setter Property="BorderThickness" Value="1.2" />
        </Style>
        <Style x:Key="MuSecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Background" Value="{StaticResource MuSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MuInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MuOutlineBrush}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource MuAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MuPrimaryButton" TargetType="Button" BasedOn="{StaticResource MuSecondaryButton}">
            <Setter Property="Background" Value="{StaticResource MuAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Orbit · 快捷轮盘"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource MuInkBrush}" />
            <TextBlock Margin="0,7,0,0"
                       Foreground="{StaticResource MuMutedBrush}"
                       Text="按住右键并点一下左键，等待菜单出现后移动，松开右键执行。" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="上方" FontWeight="SemiBold" />
            <ComboBox x:Name="UpActionBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Kind" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="右方" FontWeight="SemiBold" />
            <ComboBox x:Name="RightActionBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Kind" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="下方" FontWeight="SemiBold" />
            <ComboBox x:Name="DownActionBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Kind" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="92" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="左方" FontWeight="SemiBold" />
            <ComboBox x:Name="LeftActionBox" Grid.Column="1" DisplayMemberPath="Label" SelectedValuePath="Kind" />
        </Grid>

        <Grid Grid.Row="5" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="58" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="触发等待" FontWeight="SemiBold" />
            <Slider x:Name="DelaySlider"
                    Grid.Column="1"
                    Minimum="80"
                    Maximum="500"
                    TickFrequency="20"
                    IsSnapToTickEnabled="True"
                    ValueChanged="DelaySlider_OnValueChanged" />
            <TextBlock x:Name="DelayValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="6" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="58" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="菜单大小" FontWeight="SemiBold" />
            <Slider x:Name="SizeSlider"
                    Grid.Column="1"
                    Minimum="180"
                    Maximum="360"
                    TickFrequency="20"
                    IsSnapToTickEnabled="True"
                    ValueChanged="SizeSlider_OnValueChanged" />
            <TextBlock x:Name="SizeValueText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <StackPanel Grid.Row="7">
            <CheckBox x:Name="StartupCheckBox"
                      Margin="0,0,0,12"
                      Content="随 Windows 启动" />
            <CheckBox x:Name="FullScreenCheckBox"
                      Content="在全屏程序中禁用轮盘" />
            <Border Margin="0,24,0,0"
                    Padding="14"
                    CornerRadius="8"
                    Background="{StaticResource MuAccentSoftBrush}"
                    BorderBrush="{StaticResource MuLineBrush}"
                    BorderThickness="1">
                <TextBlock Foreground="{StaticResource MuMutedBrush}"
                           TextWrapping="Wrap"
                           Text="普通右击保持原功能；右键拖动超过少量距离后会交还给当前软件。按 Esc 或在中心松开右键可取消。" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="92" Margin="0,0,10,0" Style="{StaticResource MuSecondaryButton}"
                    Content="取消" Click="Cancel_OnClick" />
            <Button Width="92" Style="{StaticResource MuPrimaryButton}"
                    Content="保存" IsDefault="True" Click="Save_OnClick" />
        </StackPanel>
    </Grid>
</Window>
