<Window x:Class="MouseRing.Views.RadialMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MouseRing.Views"
        Title="Orbit 预览"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True">
    <views:RadialMenuControl x:Name="MenuControl"
                             IsHitTestVisible="False">
        <views:RadialMenuControl.Effect>
            <DropShadowEffect BlurRadius="22"
                              ShadowDepth="6"
                              Direction="270"
                              Opacity="0.34"
                              Color="#10131A" />
        </views:RadialMenuControl.Effect>
    </views:RadialMenuControl>
</Window>
