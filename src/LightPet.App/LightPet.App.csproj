<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>LightPet</AssemblyName>
    <RootNamespace>LightPet.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\LightPet.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.2.0</Version>
    <AssemblyTitle>Mujun Pal</AssemblyTitle>
    <Product>Mujun Pal</Product>
    <Description>Mujun Pal：MU Desk 的桌面伙伴</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LightPet.Core\LightPet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\pets\**\*">
      <Link>pets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
