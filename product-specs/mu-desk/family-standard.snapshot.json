  },
  "surface_profiles": ["light-outlined", "dark-translucent", "transparent-companion"],
  "tokens": {
    "canvas": "#EEF0F5",
    "surface": "#FAFAFC",
    "ink": "#25252A",
    "muted_ink": "#73737D",
    "violet": "#8055D9",
    "pale_violet": "#E9DEFF",
    "warm_status": "#FFD878",
    "success": "#49C978",
    "danger": "#D95C68"
  },
  "typography": {
    "display": "Segoe UI Variable",
    "cjk_fallback": "Microsoft YaHei UI"
  },
  "geometry": {
    "card_radius_px": 14,
    "control_radius_px": [8, 10],
    "ui_outline_px": [1, 1.5]
  },
  "motion_ms": [120, 180],
  "icon_packaging": {
    "windows_required_sizes": [16, 20, 24, 32, 40, 48, 64, 128, 256, 512],
